generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("OWNER")
  storeId       String?
  store         Store?    @relation(fields: [storeId], references: [id])
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("user")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  createdAt             DateTime  @default(now())
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@map("session")
}

model Store {
  id           String        @id @default(uuid())
  name         String
  businessType String
  users        User[]
  categories   Category[]
  products     Product[]
  parties      Party[]
  transactions Transaction[]
  config       Config?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@map("verification")
}

// =======================
// Enums
// =======================

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum TransactionType {
  SALE
  PURCHASE
  EXPENSE
  PAYMENT_RECEIVED
  PAYMENT_SENT
}

enum TransactionMode {
  CASH
  CREDIT
  BANK
}

// =======================
// Product Module
// =======================

model Category {
  id        String    @id @default(uuid())
  name      String
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, storeId])
  @@index([storeId])
  @@map("category")
}

model Product {
  id               String            @id @default(uuid())
  name             String
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  unit             String
  price            Float
  purchasePrice    Float
  stock            Float             @default(0)
  sku              String?           @unique
  barcode          String?
  attributes       Json?
  transactionItems TransactionItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([storeId])
  @@map("product")
}

// =======================
// Party Module
// =======================

model Party {
  id             String        @id @default(uuid())
  name           String
  mobile         String?
  email          String?
  address        String?
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type           PartyType
  openingBalance Float         @default(0)
  customData     Json?
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([storeId])
  @@map("party")
}

// =======================
// Transaction Module
// =======================

model Transaction {
  id              String            @id @default(uuid())
  invoiceNo       String            @unique
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  partyId         String?
  party           Party?            @relation(fields: [partyId], references: [id], onDelete: Cascade)
  type            TransactionType
  mode            TransactionMode
  amount          Float
  discount        Float             @default(0)
  tax             Float             @default(0)
  netAmount       Float
  paidAmount      Float             @default(0)
  dueAmount       Float             @default(0)
  note            String?
  transactionDate DateTime
  customData      Json?
  items           TransactionItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([storeId])
  @@map("transaction")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Float
  unitPrice     Float
  totalPrice    Float
  discount      Float       @default(0)
  tax           Float       @default(0)
  netPrice      Float
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_item")
}

// =======================
// Config Module
// =======================

model Config {
  id            String   @id @default(uuid())
  storeId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  enableCredit  Boolean  @default(true)
  enableStock   Boolean  @default(true)
  enableExpense Boolean  @default(true)
  currency      String   @default("BDT")
  dateFormat    String   @default("DD-MM-YYYY")
  businessType  String?
  customFields  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId])
  @@map("config")
}
