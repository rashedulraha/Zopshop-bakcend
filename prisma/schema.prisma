generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("OWNER")
  storeId       String?
  store         Store?    @relation(fields: [storeId], references: [id])
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("user")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  createdAt             DateTime  @default(now())
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@map("session")
}

model Store {
  id           String        @id @default(uuid())
  name         String
  businessType String
  users        User[]
  categories   Category[]
  products     Product[]
  parties      Party[]
  transactions Transaction[]
  brands       Brand[]
  employees    Employee[]
  accounts     BankAccount[]
  deliveries   Delivery[]
  vehicles     Vehicle[]
  roles        Role[]
  config       Config?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@map("verification")
}

// =======================
// Enums
// =======================

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum TransactionType {
  SALE
  SALE_RETURN
  PURCHASE
  PURCHASE_RETURN
  EXPENSE
  PAYMENT_RECEIVED
  PAYMENT_SENT
}

enum TransactionMode {
  CASH
  CREDIT
  BANK
}

// =======================
// Product Module
// =======================

model Category {
  id        String    @id @default(uuid())
  name      String
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, storeId])
  @@index([storeId])
  @@map("category")
}

model Product {
  id               String            @id @default(uuid())
  name             String
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId          String?
  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  unit             String
  price            Float
  purchasePrice    Float
  stock            Float             @default(0)
  minStock         Float             @default(5)
  sku              String?           @unique
  barcode          String?
  attributes       Json?
  transactionItems TransactionItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([storeId])
  @@map("product")
}

// =======================
// Party Module
// =======================

model Party {
  id             String        @id @default(uuid())
  name           String
  mobile         String?
  email          String?
  address        String?
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type           PartyType
  openingBalance Float         @default(0)
  customData     Json?
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([storeId])
  @@map("party")
}

// =======================
// Transaction Module
// =======================

model Transaction {
  id              String            @id @default(uuid())
  invoiceNo       String            @unique
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  partyId         String?
  party           Party?            @relation(fields: [partyId], references: [id], onDelete: Cascade)
  bankAccountId   String?
  bankAccount     BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  type            TransactionType
  mode            TransactionMode
  amount          Float
  discount        Float             @default(0)
  tax             Float             @default(0)
  netAmount       Float
  paidAmount      Float             @default(0)
  dueAmount       Float             @default(0)
  note            String?
  transactionDate DateTime
  customData      Json?
  items           TransactionItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  delivery        Delivery?

  @@index([storeId])
  @@map("transaction")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Float
  unitPrice     Float
  totalPrice    Float
  discount      Float       @default(0)
  tax           Float       @default(0)
  netPrice      Float
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_item")
}

// =======================
// Config Module
// =======================

model Config {
  id            String   @id @default(uuid())
  storeId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  enableCredit  Boolean  @default(true)
  enableStock   Boolean  @default(true)
  enableExpense Boolean  @default(true)
  currency      String   @default("BDT")
  dateFormat    String   @default("DD-MM-YYYY")
  businessType  String?
  customFields  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId])
  @@map("config")
}

// =======================
// New Enums
// =======================

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

// =======================
// Brand Module
// =======================

model Brand {
  id        String    @id @default(uuid())
  name      String
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, storeId])
  @@index([storeId])
  @@map("brand")
}

// =======================
// Finance Module
// =======================

model BankAccount {
  id            String        @id @default(uuid())
  name          String
  accountNumber String?
  bankName      String?
  branch        String?
  balance       Float         @default(0)
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([storeId])
  @@map("bank_account")
}

// =======================
// HR Module
// =======================

model Employee {
  id         String       @id @default(uuid())
  name       String
  mobile     String
  email      String?
  address    String?
  position   String?
  salary     Float        @default(0)
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([storeId])
  @@map("employee")
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  status     AttendanceStatus
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("attendance")
}

// =======================
// Delivery Module
// =======================

model Vehicle {
  id          String     @id @default(uuid())
  name        String
  plateNumber String     @unique
  type        String?
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([storeId])
  @@map("vehicle")
}

model Delivery {
  id            String         @id @default(uuid())
  transactionId String         @unique
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])
  driverName    String?
  driverMobile  String?
  status        DeliveryStatus @default(PENDING)
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  address       String?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([storeId])
  @@index([vehicleId])
  @@map("delivery")
}

// =======================
// Roles & Permissions Module
// =======================

model Role {
  id          String       @id @default(uuid())
  name        String
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, storeId])
  @@index([storeId])
  @@map("role")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("permission")
}
